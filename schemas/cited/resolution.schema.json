{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Logical reference only; no file opener or URL authority.",
      "properties": {
        "artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_sha256",
        "profile_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "output_truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Truncated"
        },
        "profile_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requested": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested"
        },
        "returned": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Returned"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "ResolutionProvenance": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "geometry_provenance": {
          "anyOf": [
            {
              "enum": [
                "measured_ocr",
                "native",
                "model_claimed",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry Provenance"
        },
        "ocr_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Confidence"
        },
        "owner_resolution_scope": {
          "anyOf": [
            {
              "const": "redacted_text",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Resolution Scope"
        },
        "profile_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "view_kind": {
          "anyOf": [
            {
              "enum": [
                "raw_source",
                "redacted_result"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View Kind"
        }
      },
      "title": "ResolutionProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checked_artifact_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked Artifact Sha256"
    },
    "checked_source_revision": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked Source Revision"
    },
    "checked_source_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked Source Sha256"
    },
    "excerpt": {
      "anyOf": [
        {
          "maxLength": 32768,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt"
    },
    "excerpt_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt Sha256"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResolutionProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Reason",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "enum": [
            "text",
            "spatial",
            "text_and_spatial",
            "asserted_spatial"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "status": {
      "enum": [
        "resolved",
        "unsupported",
        "stale",
        "missing",
        "invalid"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "reason"
  ],
  "title": "Resolution",
  "type": "object"
}
